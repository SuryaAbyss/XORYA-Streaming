FROM ghcr.io/puppeteer/puppeteer:latest

# We need root to install ffmpeg and perform file operations
USER root

# Install ffmpeg
RUN apt-get update && \
    apt-get install -y ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Set working directory as root
WORKDIR /app

# Copy dependency files as root
COPY package*.json ./

# Install as root (avoids permission errors during lockfile creation)
RUN npm install

# Copy application source code
COPY server ./server

# Change ownership of /app to pptruser so it can run Puppeteer safely
RUN chown -R pptruser:pptruser /app

# Switch to the non-root user that the puppeteer image expects
USER pptruser

# Remove Chromium skip configurations to let npm install the exact matching browser into the cache

# Render assigns a dynamic port via process.env.PORT
CMD ["node", "server/index.mjs"]
