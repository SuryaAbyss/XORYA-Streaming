FROM ghcr.io/puppeteer/puppeteer:latest

# Switch to root for installations
USER root

# Install ffmpeg and yt-dlp
RUN apt-get update && \
    apt-get install -y ffmpeg python3 curl && \
    curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && \
    chmod a+rx /usr/local/bin/yt-dlp && \
    rm -rf /var/lib/apt/lists/*

# Set working directory as root
WORKDIR /app

# Copy dependency files as root
COPY package*.json ./

# Install as root so npm can write package-lock.json freely
RUN npm install

# Copy application source code
COPY server ./server

# Fix permissions for pptruser
RUN chown -R pptruser:pptruser /app

# Switch to non-root for runtime
USER pptruser

# Render assigns port via process.env.PORT
CMD ["node", "server/index.mjs"]
